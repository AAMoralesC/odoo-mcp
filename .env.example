# Copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio.

ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin

# Modelos que el agente puede leer (separados por coma).
# Empieza con los seguros y amplia despues.
ALLOWED_MODELS=res.partner,res.users,res.company,sale.order,sale.order.line,account.move,account.move.line,product.product,product.template,project.project,project.task
